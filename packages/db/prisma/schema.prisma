generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenState {
  DISCOVERED
  ENRICHING
  IN_POOL
  VERIFIED
  DEPRECATED

  @@map("token_status")
}

enum PriceSource {
  POOL_CALCULATION
  COINGECKO_FALLBACK
  MANUAL_OVERRIDE

  @@map("price_source")
}

model Token {
  address String @id

  symbol   String
  name     String
  decimals Int

  logoUri     String?
  website     String?
  twitter     String?
  description String?
  coingeckoId String?
  totalSupply String

  status           TokenState @default(DISCOVERED)
  discoveredAt     DateTime   @default(now())
  lastEnrichmentAt DateTime?
  lastActivityAt   DateTime?

  isStableCoin       Boolean @default(false)
  isVerifiedManually Boolean @default(false)
  metadata           Json?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  TokenPrice      TokenPrice[]
  TokenDailyStats TokenDailyStats[]

  @@index([status])
  @@index([symbol])
  @@index([discoveredAt(sort: Desc)])
  @@index([lastActivityAt(sort: Desc)])
  @@map("tokens")
}

model TokenPrice {
  tokenAddress String
  price        Float
  priceSource  PriceSource @default(POOL_CALCULATION)
  confidence   Float       @default(1.0)
  volumeUSD    Float       @default(0)
  createdAt    DateTime    @default(now()) @db.Timestamptz()

  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  @@id([tokenAddress, createdAt])
  @@index([tokenAddress, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([priceSource])
  @@map("token_prices")
}

model TokenDailyStats {
  tokenAddress String
  date         String // Format YYYY-MM-DD

  price          Float
  priceChange1h  Float?
  priceChange24h Float?

  volume24h    Float @default(0)
  volumeUSD24h Float @default(0)

  tvlInPools Float  @default(0)
  marketCap  Float?
  fdv        Float?

  rankByTvl       Int?
  rankByVolume    Int?
  rankByMarketCap Int?

  swapCount24h     Int @default(0)
  uniqueTraders24h Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  @@id([tokenAddress, date])
  @@index([date, tvlInPools(sort: Desc)])
  @@index([date, volumeUSD24h(sort: Desc)])
  @@index([date, marketCap(sort: Desc)])
  @@index([tokenAddress, date(sort: Desc)])
  @@map("token_daily_stats")
}
