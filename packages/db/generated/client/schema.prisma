generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenState {
  DISCOVERED
  ENRICHING
  IN_POOL
  VERIFIED
  DEPRECATED

  @@map("token_status")
}

enum PriceSource {
  POOL_CALCULATION
  COINGECKO_FALLBACK
  MANUAL_OVERRIDE

  @@map("price_source")
}

model Token {
  address String @id

  symbol   String
  name     String
  decimals Int

  logoUri     String?
  website     String?
  twitter     String?
  description String?
  coingeckoId String?
  totalSupply String

  status           TokenState @default(DISCOVERED)
  discoveredAt     DateTime   @default(now())
  lastEnrichmentAt DateTime?
  lastActivityAt   DateTime?

  isStableCoin       Boolean @default(false)
  isVerifiedManually Boolean @default(false)
  metadata           Json?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  TokenPrice      TokenPrice[]
  TokenDailyStats TokenDailyStats[]

  PoolStatsAsToken0 PoolStats[] @relation("PoolStatsAsToken0")
  PoolStatsAsToken1 PoolStats[] @relation("PoolStatsAsToken1")

  @@index([status])
  @@index([symbol])
  @@index([discoveredAt(sort: Desc)])
  @@index([lastActivityAt(sort: Desc)])
  @@map("tokens")
}

model TokenPrice {
  tokenAddress String
  price        Float
  priceSource  PriceSource @default(POOL_CALCULATION)
  confidence   Float       @default(1.0)
  volumeUSD    Float       @default(0)
  createdAt    DateTime    @default(now()) @db.Timestamptz()

  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  @@id([tokenAddress, createdAt])
  @@index([tokenAddress, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([priceSource])
  @@map("token_prices")
}

model TokenDailyStats {
  tokenAddress String

  price          Float
  priceChange1h  Float?
  priceChange24h Float?

  volume24h    String
  volumeUSD24h Float

  tvlInPools String
  marketCap  Float?
  fdv        Float?

  swapCount24h Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  @@id([tokenAddress])
  @@index([tvlInPools(sort: Desc)])
  @@index([volumeUSD24h(sort: Desc)])
  @@index([marketCap(sort: Desc)])
  @@map("token_daily_stats")
}

model PoolStats {
  address        String
  tickSpacing    Int
  fee            Int
  createdAt      String
  createdAtBlock String

  token0Address String
  token1Address String
  token0Symbol  String
  token1Symbol  String
  token0LogoUri String?
  token1LogoUri String?

  sqrtPriceX96   String
  liquidity      String
  isValid        Boolean
  dayVolumeUSD   Float
  monthVolumeUSD Float
  apr            Float
  tvlUSD         Float

  token0 Token @relation(name: "PoolStatsAsToken0", fields: [token0Address], references: [address])
  token1 Token @relation(name: "PoolStatsAsToken1", fields: [token1Address], references: [address])

  @@id([address])
  @@index([createdAt, apr(sort: Desc)])
  @@index([createdAt, dayVolumeUSD(sort: Desc)])
  @@index([createdAt, monthVolumeUSD(sort: Desc)])
  @@index([createdAt, tvlUSD(sort: Desc)])
  @@map("pool_stats")
}

model LeaderboardEntry {
  id     String @id // wallet address
  wallet String @unique

  // Volume metrics (in USD)
  swapVolumeUSD             Float @default(0)
  liquidityDepositVolumeUSD Float @default(0)
  totalVolumeUSD            Float @default(0) // swapVolume + liquidityVolume

  // Liquidity metrics (current)
  currentLiquidityUSD Float @default(0) // Total liquidity across all protocols
  positionsCount      Int   @default(0) // Number of active positions

  // Breakdown by protocol type
  v3PoolsLiquidityUSD       Float @default(0) // Regular V3 positions
  stickyVaultsLiquidityUSD  Float @default(0) // Sticky Vault deposits
  autoWinVaultsLiquidityUSD Float @default(0) // AutoWin deposits

  // Points and ranking (integers - rounded)
  volumePoints    Int  @default(0) // round(1.2 × totalVolumeUSD)
  liquidityPoints Int  @default(0) // round(1.0 × currentLiquidityUSD)
  referralPoints  Int  @default(0) // 20% of referrals' points
  totalPoints     Int  @default(0) // sum of all points
  rank            Int // Current ranking position
  previousRank    Int? // Rank from last update

  // Referral
  referralCode String? @unique
  referredBy   String? // wallet address of referrer

  // Metadata
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())

  // Relations
  snapshots LeaderboardSnapshot[]

  @@index([totalPoints(sort: Desc)])
  @@index([rank])
  @@index([wallet])
  @@index([lastUpdatedAt(sort: Desc)])
  @@map("leaderboard_entries")
}

model LeaderboardSnapshot {
  id        String   @id // timestamp-wallet
  wallet    String
  timestamp DateTime @default(now())

  rank                Int
  totalPoints         Int
  totalVolumeUSD      Float
  currentLiquidityUSD Float
  positionsCount      Int

  // Relation
  leaderboardEntry LeaderboardEntry @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  @@index([wallet, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@map("leaderboard_snapshots")
}
